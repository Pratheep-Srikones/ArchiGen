{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "data": {
      "type": "object",
      "properties": {
        "requirements": {
          "type": "object",
          "properties": {
            "project_name": { "type": "string" },
            "user_roles": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "role": { "type": "string" },
                  "description": { "type": "string" }
                }
              }
            },
            "functional_requirements": {
              "type": "array",
              "items": { "$ref": "#/definitions/requirement" }
            },
            "non_functional_requirements": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "category": { "type": "string" },
                  "requirement": { "type": "string" },
                  "justification": { "type": "string" }
                }
              }
            }
          }
        },
        "architecture": {
          "type": "object",
          "properties": {
            "architectural_style": {
              "type": "object",
              "properties": {
                "style_name": { "type": "string" },
                "reasoning": { "type": "string" }
              }
            },
            "core_components": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "responsibility": { "type": "string" },
                  "suggested_pattern": { "type": "string" },
                  "pattern_justification": { "type": "string" }
                }
              }
            },
            "data_flow_strategy": { "type": "string" }
          }
        },
        "tech_stack": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "technology": { "type": "string" },
              "justification": { "type": "string" }
            }
          }
        },
        "mermaid_code": { "type": "string" }
      }
    },
    "message": { "type": "string" },
    "error": { "type": ["string", "null"] }
  },
  "definitions": {
    "requirement": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "requirement": { "type": "string" },
        "priority": { "enum": ["High", "Medium", "Low"] },
        "justification": { "type": "string" }
      }
    }
  }
}
