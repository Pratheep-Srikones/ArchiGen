FROM node:22-alpine

# Install pnpm globally
RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

# Copy lockfile and package config to leverage layer caching
COPY package.json pnpm-lock.yaml ./

# Store pnpm store cache in a dedicated location inside the container 
# to keep installations isolated and speedy
RUN pnpm config set store-dir /workspaces/.pnpm-store
RUN pnpm install

# Copy the rest of your files (fallback for initial setup)
COPY . .

EXPOSE 5173

# Run the dev server targeting all network interfaces
CMD ["pnpm", "run", "dev", "--host", "0.0.0.0"]